+    let f0 = mix(vec3<f32>(0.04), base, metallic);
+    let env = env_brdf_approx(roughness, n_dot_v);
+    let specular = f0 * env.x + env.y;
+    return frame.ambient.rgb * ((1.0 - specular) * (1.0 - metallic) * base + specular);
