+            att = att * smoothstep(li.direction.w, li.params.x, dot(-ldir, li.direction.xyz));
+        }
+        rgb = rgb + pbr_direct(n, v, ldir, li.color.rgb * att, base, m, r);
+    }
+    return rgb;
+}
